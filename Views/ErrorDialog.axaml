<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:localization="using:XKeenMihomoGenerator.Data.Localization"
        x:Class="XKeenMihomoGenerator.ErrorDialog"
        Title="{localization:Localize error.title}"
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight"
        MinWidth="280"
        MinHeight="140"
        ShowInTaskbar="True"
        SystemDecorations="None"
        CanResize="False"
        Background="Transparent">

    <Border Background="Transparent" BorderBrush="#6A70E0" BorderThickness="2" CornerRadius="3">
		
        <Grid RowDefinitions="Auto, *">

            <Border Grid.Row="0"
                    Background="#5459C5"
                    Padding="6, 4"
                    CornerRadius="1.5, 1.5, 0, 0"
                    PointerPressed="TitleBarPointerPressed">
				
                <Grid ColumnDefinitions="Auto, *, Auto">
				
                    <Image Grid.Column="0"
                           x:Name="errorImage"
                           Source="avares://XKeenMihomoGenerator/Assets/Images/error.png"
                           Stretch="Uniform"
                           StretchDirection="DownOnly"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="1"
                               Text="{localization:Localize error.title}"
                               TextWrapping="Wrap"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                    <Button Grid.Column="2"
                            x:Name="closeErrorButton"
                            Content="&#x2717;"
                            FontWeight="Bold"
                            Padding="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            HorizontalContentAlignment="Right"
                            VerticalContentAlignment="Center"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            Click="CloseDialog"/>

                </Grid>

            </Border>

            <Border Grid.Row="1"
                    Background="#8C92FF"
                    Padding="6, 4"
                    CornerRadius="0, 0, 1.5, 1.5"
                    ClipToBounds="True">
            
                <Grid RowDefinitions="*, Auto" RowSpacing="10">
            
                    <TextBlock Grid.Row="0"
                               x:Name="Message"
                               TextWrapping="Wrap"
                               Foreground="White"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"/>

                    <Button Grid.Row="1"
                            Content="OK"
                            HorizontalContentAlignment="Center"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Stretch"
                            Background="#6A70E0"
                            Foreground="White"
                            BorderThickness="0"
                            Click="CloseDialog"/>

                </Grid>
            
            </Border>

        </Grid>

    </Border>

    <Window.Styles>

        <Style Selector="Button#closeErrorButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="#70FFFFFF"/>
        </Style>

        <Style Selector="Button#closeErrorButton:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="#40FFFFFF"/>
        </Style>

    </Window.Styles>

</Window>
