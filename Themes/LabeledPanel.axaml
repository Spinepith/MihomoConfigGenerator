<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:XKeenMihomoGenerator.Controls">

  <Design.PreviewWith>
    <Border Padding="20">
        <controls:LabeledPanel Label="Preview">
            <StackPanel Orientation="Vertical" Spacing="4">
                <TextBox/>
                <TextBox/>
                <Button Content="Добавить"/>
            </StackPanel>
        </controls:LabeledPanel>
    </Border>
  </Design.PreviewWith>

  <Style Selector="controls|LabeledPanel">
    <Setter Property="Template">
        <ControlTemplate TargetType="controls:LabeledPanel">
            <Border CornerRadius="{TemplateBinding CornerRadius}"
                    ClipToBounds="True">
			    <StackPanel Spacing="4" Background="#5459C5">
                    <TextBlock Text="{TemplateBinding Label}"
                               HorizontalAlignment="{TemplateBinding LabelAlignment}"
                               FontWeight="Bold"
                               Padding="4, 0"/>
                    <ContentPresenter Content="{TemplateBinding ContentContainer}"/>
                </StackPanel>
            </Border>
        </ControlTemplate>
    </Setter>
  </Style>

</Styles>
