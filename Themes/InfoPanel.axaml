<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:MihomoProxyGenerator.Controls"
        xmlns:localization="using:MihomoProxyGenerator.Data.Localization">
        
  <Design.PreviewWith>
    <Border Padding="20">
      <controls:InfoPanel CornerRadius="3"></controls:InfoPanel>
    </Border>
  </Design.PreviewWith>

    <Style Selector="controls|InfoPanel">
        <Setter Property="Template">
          <ControlTemplate TargetType="controls:InfoPanel">
			  <Border x:Name="OuterBorder"
                      CornerRadius="{TemplateBinding CornerRadius}"
                      Background="Transparent"
                      BorderBrush="#6A70E0"
                      BorderThickness="2"
                      Padding="2">
                  <Border CornerRadius="{Binding CornerRadius, ElementName=OuterBorder}"
                          ClipToBounds="true">
                      <Grid RowDefinitions="Auto, *" Background="#8C92FF">
					      <Button Grid.Row="0"
                                  x:Name="closeInfoButton"
                                  Content="🞩"
                                  FontWeight="Bold"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  HorizontalContentAlignment="Center"
                                  VerticalContentAlignment="Center"
                                  Background="Transparent"
                                  Foreground="White"
                                  BorderThickness="0"/>
                          <Grid Grid.Row="1"
                                RowDefinitions="*, Auto, Auto"
                                RowSpacing="10"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Stretch"
                                Margin="40, 0, 40, 40">
                              <Image Grid.Row="0"
                                     Source="avares://MihomoProxyGenerator/Assets/star.png"
                                     Stretch="Uniform"
                                     StretchDirection="DownOnly"
                                     MaxWidth="280"
                                     MaxHeight="280"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>
                              <TextBlock Grid.Row="1"
                                         TextWrapping="Wrap"
                                         TextAlignment="Center"
                                         Background="Transparent"
                                         Foreground="White"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         MaxWidth="500">
                                  <Run Text="{localization:Localize infoPanel.description}"/>
                                  <LineBreak/>
                                  <LineBreak/>
                                  <Run Text="{localization:Localize infoPanel.author}"/>
                                  <LineBreak/>
                                  <Run Text="{localization:Localize infoPanel.version}"/>
                              </TextBlock>
                              <Button Grid.Row="2"
                                      x:Name="updateButton"
                                      Content="{localization:Localize infoPanel.checkUpdates}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      HorizontalContentAlignment="Center"
                                      VerticalContentAlignment="Center"
                                      Background="#6A70E0"
                                      Foreground="White"
                                      BorderThickness="0"/>
                          </Grid>
                      </Grid>
                  </Border>
              </Border>
          </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="controls|InfoPanel:pointerover /template/ Border#OuterBorder">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style Selector="controls|InfoPanel /template/ Button#closeInfoButton:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="#30000000"/>
    </Style>

    <Style Selector="controls|InfoPanel /template/ Button#closeInfoButton:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>

</Styles>
